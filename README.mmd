    D1[("<b>trajectories</b><br/>scene · frame · agent · x · y<br/>vx · vy · speed · heading<br/>nearest_dist · density")]
    D2[("<b>windows</b><br/>window_id · scene · t0 · <b>ego_id</b><br/>agents · hist · fut · overlap_fraction")]
