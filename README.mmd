    direction TB
    S1["<b>download_ethucy.py</b><br/>the 5 scenes"]
    S2["<b>setup_agentformer.py</b><br/>5 CHECKPOINTS, one per held-out scene.<br/>record the checksum and the commit"]
    S3["<b>extract_attention.py</b><br/>run once, cache"]
    S4["<b>run_all.py</b><br/>one command, whole study"]
end
